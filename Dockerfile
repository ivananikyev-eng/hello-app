# 1. Берём готовую основу: маленький Linux, где уже есть Python
FROM python:3.14-slim

# 2. Внутри контейнера создаём папку /app и переходим в неё
WORKDIR /app

# 3. Копируем наш сайт с ноутбука внутрь контейнера
COPY app.py .

# 4. Сообщаем, что сайт слушает порт 8000
EXPOSE 8000

# 5. Команда, которая запускается при старте контейнера
CMD ["python", "-u", "app.py"]